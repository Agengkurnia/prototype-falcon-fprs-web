# Falcon Prototype — copy to .env for local dev
# Vercel production: set these in Project → Settings → Environment Variables

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# FSD Generate
# FSD_EXECUTOR=local          # local (Node fallback) | worker (production default)
# FSD_MAX_OUTPUT_TOKENS=8192
# FSD_PROMPT_VERSION=fsd-flow-v2
# FSD_AI_CONCURRENCY=5
# FSD_RATE_LIMIT_PER_HOUR=20       # default 3; naikkan untuk dev/testing

# Vercel KV + Blob (production + Windows worker)
# Blob store harus Public (bukan Private) — cocok dengan access:'public' di blob-store.js
# Standard names OR Vercel/Upstash integration prefix (e.g. upstash_aks_KV_REST_API_URL)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=           # dari store Blob yang aktif (bukan BLOB_STORE_ID saja)
# BLOB_STORE_ID=                   # opsional; untuk OIDC di Vercel

# Windows worker webhook (Vercel → VM)
# WINDOWS_WORKER_WEBHOOK_URL=https://internal-server:3950/fsd/jobs
# FSD_WEBHOOK_SECRET=

# Windows worker settings (on VM)
# FSD_WORKER_PORT=3950
# FSD_PROTOTYPE_ROOT=D:\Work\Source\Comsup\falcon\Prototype
# FSD_CAPTURE_BASE_URL=http://127.0.0.1:5500
# FSD_WORKER_GIT_PULL=false

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
